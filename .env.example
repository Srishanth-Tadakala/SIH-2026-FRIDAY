# ==============================================================================
# F.R.I.D.A.Y. POLAR DIGITAL TWIN PLATFORM (SIH 2026 - SIH26060)
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials:
#   copy .env.example .env     (Windows PowerShell / CMD)
#   cp .env.example .env       (Linux / macOS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MAINLAND HQ CLOUD DATABASE: MONGODB ATLAS (NCPOR Goa Cloud)
# ------------------------------------------------------------------------------
# Connection string for MongoDB Atlas cluster at Mainland Mission Control.
# Replicates crisis episodes, CBR memory, wear audits, and copilot histories
# over bandwidth-compressed polar satcom (94.2% delta compression).
#
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_ATLAS_URI=

# Optional alternative variable name (both are supported by F.R.I.D.A.Y.):
# CLOUD_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority


# ------------------------------------------------------------------------------
# 2. LOCAL STATION EDGE DATABASE: MONGODB (Bharati / Maitri Station Edge)
# ------------------------------------------------------------------------------
# Local MongoDB instance running on station edge servers.
# If local MongoDB is offline or uninstalled, F.R.I.D.A.Y. automatically falls
# back to the zero-dependency embedded atomic edge store (data/edge_storage/*.json).
LOCAL_MONGO_URI=mongodb://localhost:27017


# ------------------------------------------------------------------------------
# 3. GROQ LPU COGNITIVE BRAIN (LLaMA-3.3-70B-Versatile)
# ------------------------------------------------------------------------------
# Groq LPU API key for ultra-fast, sub-400ms causal reasoning and copilot dialogue.
# If omitted, F.R.I.D.A.Y. automatically executes local edge neural fallback (<1.4ms).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# ------------------------------------------------------------------------------
# 4. SECURITY, JWT AUTHENTICATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'testing', or 'production'
# In production, unauthenticated requests are strictly rejected with 401.
FRIDAY_ENVIRONMENT=development

# JWT HMAC Secret Key (generate with `openssl rand -hex 32`)
FRIDAY_SECRET_KEY=friday-polar-twin-secret-key-change-in-production-2026
FRIDAY_JWT_ALGORITHM=HS256
FRIDAY_JWT_EXPIRATION_MINUTES=60

# Station Commander Tier 3 Emergency Authorization PIN
FRIDAY_COMMANDER_PIN=BHARATI-CMD-2026

# Allowed CORS Origins (JSON list or comma-separated URLs)
FRIDAY_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000"]

# Maximum Concurrent WebSocket Connections
FRIDAY_WS_MAX_CONNECTIONS=100

# ------------------------------------------------------------------------------
# 5. EDGE STORAGE PATHS (Optional overrides)
# ------------------------------------------------------------------------------
# Custom directory for local atomic persistence if different from default.
# FRIDAY_EDGE_STORAGE_DIR=data/edge_storage

