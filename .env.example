# ==============================================================================
# F.R.I.D.A.Y. POLAR DIGITAL TWIN PLATFORM (SIH 2026 - SIH26060)
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and configure according to your operational environment:
#   copy .env.example .env     (Windows PowerShell / CMD)
#   cp .env.example .env       (Linux / macOS)
#
# NOTE: F.R.I.D.A.Y. supports both standard configuration names and 'FRIDAY_'
# prefixed environment variable aliases.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & RUNTIME MODE
# ------------------------------------------------------------------------------
# Options: 'development', 'testing', or 'production'
# In 'production', strict JWT validation, 32+ char secret keys, and customized
# Commander PINs are cryptographically enforced at startup.
ENVIRONMENT=development
# Alias: FRIDAY_ENVIRONMENT=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false


# ------------------------------------------------------------------------------
# 2. SECURITY, JWT AUTHENTICATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing JWT bearer tokens (HS256).
# In production, generate a secure random string: openssl rand -hex 32
JWT_SECRET_KEY=friday-antarctica-secret-key-development-mode-2026
# Alias: FRIDAY_SECRET_KEY=friday-antarctica-secret-key-development-mode-2026

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Alias: FRIDAY_JWT_EXPIRATION_MINUTES=1440

# Station Commander Safety Interlock PIN (Required for Tier 3 Emergency Execution)
# In production, must be at least 8 characters long and changed from default.
COMMANDER_PIN=BHARATI-CMD-2026
# Alias: FRIDAY_COMMANDER_PIN=BHARATI-CMD-2026

# Allowed CORS Origins (JSON array or comma-separated list of origins)
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
# Alias: FRIDAY_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Maximum Concurrent WebSocket Connections
WS_MAX_CONNECTIONS=100
# Alias: FRIDAY_WS_MAX_CONNECTIONS=100


# ------------------------------------------------------------------------------
# 3. DATABASE SUBSYSTEMS (DUAL-MODE PERSISTENCE)
# ------------------------------------------------------------------------------
# Local Station Edge Database (Bharati / Maitri Station Edge server)
# If local MongoDB is unavailable, F.R.I.D.A.Y. automatically activates zero-dependency
# embedded atomic JSON persistence in data/edge_storage/
LOCAL_MONGO_URI=mongodb://localhost:27017
# Alias: MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=friday_antarctic_twin

# Mainland HQ Cloud Database (MongoDB Atlas / NCPOR Goa Cloud)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_ATLAS_URI=
# Alias: CLOUD_MONGO_URI=

# Embedded Atomic Storage Path (Fallback when MongoDB is offline)
EDGE_STORAGE_PATH=data/edge_storage/friday_embedded_edge.json
# Alias: FRIDAY_EDGE_STORAGE_DIR=data/edge_storage


# ------------------------------------------------------------------------------
# 4. GROQ LPU COGNITIVE ENGINE (LLaMA-3.3-70B-Versatile)
# ------------------------------------------------------------------------------
# Optional API key for ultra-fast cloud LLM causal reasoning.
# If omitted or offline, F.R.I.D.A.Y. automatically executes local edge deterministic
# neural fallback (<1.4ms) with zero downtime.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=12.0


# ------------------------------------------------------------------------------
# 5. SATCOM TELEMETRY BANDWIDTH & RATE LIMITING
# ------------------------------------------------------------------------------
# Simulated Iridium polar satcom bandwidth limit in bits per second (default: 2400 bps)
SATCOM_BANDWIDTH_LIMIT_BPS=2400
RATE_LIMIT_PER_MINUTE=120
